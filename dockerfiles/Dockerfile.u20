FROM ubuntu:20.04 AS deps
ARG DEBIAN_FRONTEND=noninteractive

# General dependencies
RUN set -eux \
    && apt-get update \
    && apt-get install -y --no-install-recommends --fix-missing \
        ca-certificates \
        curl \
        gdb \
        git \
        gnupg \
        lsb-release \
        software-properties-common \
        zip

# Add Kitware package feed for newer CMake (focal ships 3.16.3), VMF requires >= 3.19.
RUN set -eux \
    && apt-get update \
    && apt-get install -y apt-transport-https \
    && curl -kfsSL https://apt.kitware.com/keys/kitware-archive-latest.asc | gpg --dearmor -o /usr/share/keyrings/kitware-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/  focal main" >/etc/apt/sources.list.d/kitware.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends --fix-missing \
        cmake

# Development dependencies
RUN set -eux \
    && apt-get update \
    && apt-get install -y --no-install-recommends --fix-missing \
        build-essential \
        cmake \
        doxygen \
        graphviz \
        libcurl4-openssl-dev \
        python3-dev \
        python3-pip \
        python3-setuptools \
        libselinux1-dev

# Additional development dependencies
# Install clang-18 from universe (focal has 10, AFL++ 5.x minimum 11, 18 is newer available)
RUN set -eux \
    && apt-add-repository universe \
    && apt-get update \
    && apt-get install -y --no-install-recommends --fix-missing \
        clang-18 \
        libclang-rt-18-dev \
        lld-18 \
        llvm-18 \
        llvm-18-dev \
    && for tool in \
        clang \
        clang++ \
        lld \
        llvm-config \
        llvm-ar \
        llvm-as \
        llvm-dis \
        llvm-link \
        llvm-nm \
        llvm-objcopy \
        llvm-objdump \
        llvm-ranlib \
        llvm-strip \
    ; do update-alternatives --install "/usr/bin/$tool" "$tool" "/usr/bin/${tool}-18" 100; done \
    && update-alternatives --install /usr/bin/ld ld /usr/bin/ld.lld-18 100

# ENV -ldl: AFL++ compiler-rt calls dlsym; VMF CMake links it, but persist for downstream builds on glibc < 2.34.
ENV LDFLAGS="-ldl"

FROM deps AS aflpp

# Clone and build firejail
RUN git clone --depth 1 https://github.com/netblue30/firejail.git /usr/local/src/firejail \
    && cd /usr/local/src/firejail \
    && ./configure --prefix=/usr --enable-selinux \
    && make \
    && make install-strip 

# Clone and build AFL++
RUN set -eux \
    && cd /usr/local/src \
    && git clone --depth 1 -b v5.00c https://github.com/AFLplusplus/AFLplusplus.git \
    && cd AFLplusplus \
    && make all \
    && make install \
    && command -v afl-cc \
    && command -v afl-fuzz \
    && command -v afl-showmap \
    && afl-cc --version \
    && afl-cc --help

FROM aflpp AS vmf

# Clone, build, install VMF
RUN set -eux \
    && cd /usr/local/src \
    && mkdir vmf \
    && git clone --depth 1 https://github.com/draperlaboratory/vadermodularfuzzer.git vmf \
    && cd vmf \
    && mkdir -p build \
    && cd build \
    && cmake -DCMAKE_INSTALL_PREFIX=/usr/local .. \
    && make -j \
    && make install \
    && command -v vader

RUN echo "Deprecation notice: VMF example support for this distribution is ending; migrate to a supported platform."
